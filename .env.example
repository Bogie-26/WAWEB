# ── WA Service environment ──────────────────────────────────────────────
# Copy ke .env dan sesuaikan.

# Server
PORT=3006

# Database (PostgreSQL terpisah dari PLTD)
POSTGRES_DB=wa_service
POSTGRES_USER=wa_service
POSTGRES_PASSWORD=CHANGE_ME_DB
DATABASE_URL=postgresql://wa_service:CHANGE_ME_DB@db:5432/wa_service?schema=public

# Admin web (GENERATE hash: npm run hash:password -- "password-rahasia")
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$CHANGE_ME_BCRYPT_HASH

# JWT secret (acak panjang. Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_JWT_SECRET

# WhatsApp session (container mount /app/.wwebjs_auth)
WA_SESSION_PATH=./.wwebjs_auth
# Chromium executable (docker image pakai /usr/bin/chromium; lokal kosong = puppeteer bundled)
CHROME_BIN=

# Webhook
# PRODUCTION: biarkan false (private/internal/loopback DIBLOKIR)
# DEVELOPMENT: true agar bisa test lokal (http://localhost, 192.168.x.x, dll)
WEBHOOK_ALLOW_PRIVATE_IP=false
WEBHOOK_TIMEOUT_MS=10000

# Event retention (jam) — body pesan disimpan sementara untuk recovery
EVENT_RETENTION_HOURS=72